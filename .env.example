# Environment Configuration for Meridian Vendor Assessment Pipeline
# (No secrets are committed. Copy this file to .env for local overrides if needed)

# Logging
LOG_LEVEL=INFO

# Application Paths
CONFIG_PATH=config/criticality.yaml
DEFAULT_INPUT_CSV=data/input/vendors.csv
DEFAULT_OUTPUT_JSON=data/output/criticality_results.json

# OSINT Phase 1 Search Execution Provider Configuration (Optional)
# Supported providers: google_cse, brave, bing, serpapi
MERIDIAN_SEARCH_PROVIDER=
MERIDIAN_GOOGLE_API_KEY=
MERIDIAN_GOOGLE_CSE_ID=
MERIDIAN_BRAVE_API_KEY=
MERIDIAN_BING_API_KEY=
MERIDIAN_SERPAPI_KEY=

# Level 5 Semantic Filtering & RAG Embeddings (Optional — disabled by default for offline runs)
MERIDIAN_ENABLE_RAG_EMBEDDINGS=false
MERIDIAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Level 6 Local LLM Signal Classification via Ollama (Optional — disabled by default)
MERIDIAN_OLLAMA_ENABLED=false
MERIDIAN_OLLAMA_ENDPOINT=http://localhost:11434
MERIDIAN_OLLAMA_MODEL=

# Level 4 & 9 Persistence Paths
MERIDIAN_EVIDENCE_DB_PATH=data/output/evidence_store/meridian_evidence.sqlite3
MERIDIAN_AI_RISK_POLICY_PATH=config/ai_risk_scoring.yaml

