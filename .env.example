# Environment Configuration Template for Meridian Vendor Assessment Pipeline (UncoverAI)
# (No secrets are committed. Copy this file to .env for local overrides if needed)

# Logging & Application Paths
LOG_LEVEL=INFO
CONFIG_PATH=config/criticality.yaml
DEFAULT_INPUT_CSV=data/input/meridian_vendors.csv
DEFAULT_OUTPUT_JSON=data/output/criticality_results.json
MERIDIAN_EVIDENCE_DB_PATH=data/output/evidence_store/meridian_evidence.sqlite3
MERIDIAN_AI_RISK_POLICY_PATH=config/ai_risk_scoring.yaml

# External OSINT Integrations (Level 3A Search Discovery & Level 4 Webpage Retrieval Fallback)
MERIDIAN_SEARCH_PROVIDER=serper
MERIDIAN_SERPER_API_KEY=
MERIDIAN_SCRAPERAPI_KEY=

# Dual-Model Local LLM Routing via Ollama (6 GB VRAM Budget)
# Model A (llama3.2:latest ~2.0 GB) -> Level 3B URL & Search-Result Triage
# Model B (mistral:latest ~4.4 GB)  -> Level 6 Evidence Signal Classification & Level 8 Risk Summarization
MERIDIAN_OLLAMA_ENABLED=true
MERIDIAN_OLLAMA_ENDPOINT=http://localhost:11434
MERIDIAN_OLLAMA_TRIAGE_MODEL=llama3.2:latest
MERIDIAN_OLLAMA_ANALYSIS_MODEL=mistral:latest
MERIDIAN_OLLAMA_SUMMARY_MODEL=mistral:latest
MERIDIAN_OLLAMA_MODEL=mistral:latest
MERIDIAN_OLLAMA_TIMEOUT_SECONDS=25.0
MERIDIAN_OLLAMA_KEEP_ALIVE=2m
MERIDIAN_OLLAMA_UNLOAD_ON_SWITCH=true
MERIDIAN_OLLAMA_NUM_GPU=99

# Level 5: Separate Semantic Filtering & RAG Embedding Model (Never routed through Ollama generative models)
MERIDIAN_ENABLE_RAG_EMBEDDINGS=true
MERIDIAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

